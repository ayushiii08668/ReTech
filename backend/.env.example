# Server & Runtime Environment
NODE_ENV=production
PORT=5000

# Database Configuration (MongoDB Atlas or Local Instance)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/retech?retryWrites=true&w=majority

# Authentication & Security
JWT_SECRET=generate-a-strong-64-char-random-secret-key-here
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated for multiple domains)
CORS_ORIGIN=https://retech-platform.vercel.app,http://localhost:5173

# Optional Initial Administrator Credentials (Auto-provisioned on initial boot if no admin exists)
ADMIN_EMAIL=admin@retech.in
ADMIN_PASSWORD=Admin@ReTech2026!

# Optional Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
